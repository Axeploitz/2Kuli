# Salin file ini menjadi .env lalu isi. JANGAN upload .env ke GitHub.

# Discord Developer Portal > aplikasi bot > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=

# ID server Discord (klik kanan nama server > Copy Server ID)
GUILD_ID=

# ID role admin/staff yang boleh melihat & memproses tiket (pisahkan koma kalau lebih dari satu)
STAFF_ROLE_ID=

# (Opsional) ID kategori, atau ID channel panel (tiket dibuat di kategori yang sama)
TICKET_CATEGORY_ID=

# ID grup/community Roblox 2Kuli Project
ROBLOX_GROUP_ID=559137025

# Discord user ID owner yang di-tag di tiket (pisahkan koma)
OWNER_USER_IDS=


# Roblox Open Cloud API key (milik grup, izin group:read). Dipakai untuk cek eligible payout otomatis.
ROBLOX_API_KEY=

# ---- Pembayaran ----
# Discord user ID yang boleh mengonfirmasi pembayaran (thalviorr)
PAYMENT_VERIFIER_IDS=
# Nama file QRIS di folder bot/assets/
QRIS_FILE=qris.png

# ---- Dashboard website (Supabase) ----
SUPABASE_URL=
# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). RAHASIA, hanya untuk bot.
SUPABASE_SECRET_KEY=
# Akun dashboard yang tercatat sebagai pencatat & validator uang masuk
DASHBOARD_RECORDER_EMAIL=

# Discord user ID = email akun dashboard, pisahkan koma (untuk tombol Proses → ceklis Diproses di web)
OWNER_ACCOUNTS=

# ---- Metode pembayaran ----
# Rekening untuk transfer bank (tampil ke buyer)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# QRIS: isi true kalau sudah siap (gambar di bot/assets/qris.png)
QRIS_ENABLED=false

# ---- Testimoni ----
# (Opsional) ID channel #testimoni. Kosong = dicari dari nama "testimoni", atau dibuat otomatis.
TESTIMONI_CHANNEL_ID=
